{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ht-timchen/Adelaide-CSIT-GRC/schema/seminar.schema.json",
  "title": "Seminars data file",
  "type": "object",
  "required": ["seminars"],
  "additionalProperties": false,
  "properties": {
    "seminars": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/thesisSeminar" },
          { "$ref": "#/$defs/eventSeminar" }
        ]
      }
    }
  },
  "$defs": {
    "baseFields": {
      "type": "object",
      "required": ["id", "type", "date", "time", "title", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "minLength": 3
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "type": "string",
          "minLength": 4
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "cancelled", "completed"]
        }
      }
    },
    "thesisSeminar": {
      "allOf": [
        { "$ref": "#/$defs/baseFields" },
        {
          "type": "object",
          "required": [
            "type",
            "candidate",
            "supervisor",
            "abstract"
          ],
          "properties": {
            "type": {
              "enum": ["candidature_review", "thesis_defence"]
            },
            "candidate": { "type": "string", "minLength": 1 },
            "supervisor": { "type": "string", "minLength": 1 },
            "abstract": { "type": "string", "minLength": 1 },
            "location": { "type": "string" },
            "teams_url": { "type": "string", "format": "uri" },
            "zoom_url": { "type": "string", "format": "uri" }
          },
          "anyOf": [
            { "required": ["teams_url"] },
            { "required": ["zoom_url"] }
          ],
          "not": {
            "required": ["teams_url", "zoom_url"]
          }
        }
      ]
    },
    "eventSeminar": {
      "allOf": [
        { "$ref": "#/$defs/baseFields" },
        {
          "type": "object",
          "required": ["type", "speaker", "location"],
          "properties": {
            "type": {
              "enum": ["hdr_seminar", "special"]
            },
            "speaker": { "type": "string", "minLength": 1 },
            "location": { "type": "string", "minLength": 1 },
            "abstract": { "type": "string" },
            "online_url": { "type": "string", "format": "uri" }
          }
        }
      ]
    }
  }
}
